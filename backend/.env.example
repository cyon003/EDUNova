PORT=5050
NODE_ENV=development
# Set to 1 only behind one trusted reverse proxy that sends X-Forwarded-Proto.
TRUST_PROXY=0
# Leave empty for local development (uses backend/uploads). Production requires
# an absolute persistent-disk path, for example /srv/edunova/uploads.
UPLOAD_ROOT=

MONGO_URI=mongodb://127.0.0.1:27017/edunova
JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=edunova_refresh
# Production uses the database sessionTimeout setting as the maximum lifetime
# from login. ACCESS_TOKEN_EXPIRES_IN must be a whole number with s, m, h or d.

AI_GENERAL_RATE_LIMIT_PER_MINUTE=5
AI_CHATBOT_RECENT_CONTEXT_LIMIT=3

PYTHON_CONFUSION_URL=http://127.0.0.1:5002
PYTHON_CONFUSION_TIMEOUT_MS=5000

# SMTP email delivery (use an app password, never your normal email password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=EDUNOVA <your_email@example.com>

# Admin-only subscription simulation; also requires NODE_ENV=development.
ENABLE_DEV_SUBSCRIPTIONS=false

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=1600
GEMINI_MAX_ANSWER_LENGTH=8000
GEMINI_MAX_PROMPT_CHARACTERS=30000

# Stripe hosted Checkout (server only). Configure the matching webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
