MONGO_URI=mongodb://127.0.0.1:27017/edunova
MONGO_DB_NAME=test
MIN_TRAINING_ROWS=50
MIN_ROWS_PER_CLASS=10
MIN_UNIQUE_STUDENTS=10
TEST_SIZE=0.2
RANDOM_STATE=42
N_ESTIMATORS=200
DECISION_THRESHOLD=0.5
MODEL_VERSION=3b-v1
# Optional absolute path to a provisioned production model bundle.
MODEL_BUNDLE_PATH=
# Keep loopback locally. Use 0.0.0.0 only on a private container network.
CONFUSION_HOST=127.0.0.1
CONFUSION_PORT=5002
