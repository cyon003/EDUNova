AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=1600
GEMINI_MAX_ANSWER_LENGTH=8000
GEMINI_MAX_PROMPT_CHARACTERS=30000
CHATBOT_MAX_MESSAGE_LENGTH=1000
CHATBOT_MAX_REQUEST_BYTES=1048576
# Keep loopback locally. Use 0.0.0.0 only on a private container network.
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=5001
